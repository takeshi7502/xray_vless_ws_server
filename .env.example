# ============================================================
# Xray VLESS-WS Server - environment configuration
# Run `bash run.sh` to configure interactively, or edit manually.
#
# RUN_MODE controls how the server is exposed to the internet:
#   quick_tunnel  -> random *.trycloudflare.com (no domain, no config)
#   named_tunnel  -> fixed domain via a Cloudflare Named Tunnel (token)
#   direct        -> fixed domain via Cloudflare proxied DNS -> VPS (no cloudflared)
# ============================================================

# --- Quick Tunnel (default) ---------------------------------
RUN_MODE=quick_tunnel
PORT=127.0.0.1:8888
# IPv6: PORT=[::1]:8888 or [::]:8888. Multiple listeners are comma-separated.
WS_HOST=trycloudflare.com
TUNNEL_TOKEN=

# --- Named Tunnel --------------------------------------------
# RUN_MODE=named_tunnel
# PORT=127.0.0.1:8888
# WS_HOST=vless.example.com
# TUNNEL_TOKEN=<connector token from Cloudflare Zero Trust>

# --- Direct (Cloudflare proxied DNS -> VPS) ------------------
# RUN_MODE=direct
# PORT=0.0.0.0:80
# WS_HOST=vless.example.com
# TUNNEL_TOKEN=

# --- Common settings -----------------------------------------
# A random UUID is generated automatically if this is left blank.
XRAY_UUID=
# Client destination addresses, NOT the TLS SNI. Existing .env values are preserved.
FAKE_SNI=api24-normal-alisg.tiktokv.com#FreeTiktok,172.67.168.158#FreeVNPT,vega-prime.huskydg.dpdns.org#FreeMobiFone
WS_PATH=/vless
# Optional: 2-letter country code for flag prefix (e.g. VN, JP, US). Leave blank to skip.
COUNTRY_CODE=
TRANSPORT=websocket
PORT_MODE=443
# xHTTP mode: auto (new default), packet-up, stream-up, or stream-one.
# Quick Tunnel remains WebSocket-only in the launchers.
XHTTP_MODE=auto
# WARP: false = disabled, true = all traffic, ip6only = IPv6 via WARP, IPv4 direct.
ENABLE_WARP=false
WEBHOOK_URL=

# ECH is disabled by default. Requires a compatible client and ECH-enabled domain.
# Example DNSECH=https://1.1.1.1/dns-query (the actual tunnel host is encoded in the link).
DNSECH=

# Optional independent TLS listener(s); serves the FIRST configured transport only.
# Example TLS_PORT=0.0.0.0:443 or [::]:8443. Must not overlap PORT/internal demux ports.
# Supply an existing full certificate chain and matching unencrypted private key in PEM format.
# No certificate is generated automatically. Renew certificates separately and restart.
# With Direct + Cloudflare Full (strict), use a valid origin certificate on :443.
TLS_PORT=
TLS_PEM=
TLS_KEY=

# Logger is local-only by default. Access a remote logger through SSH port forwarding.
# PASSWORD protects the UI and /logs (Basic Auth; any username). Empty = local access.
# Non-local LOGGER_HOST requires PASSWORD. Do not expose plain HTTP to the internet.
LOGGER_HOST=127.0.0.1
PASSWORD=
DEBUG_MODE=false

# Preserve fork's raw links by default. A Base64 copy is ALWAYS written to frp_info.base64.
# Set base64 to also encode frp_info.config (upstream format). Launchers display either.
FRP_INFO_FORMAT=plain
